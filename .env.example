# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI embeddings
VOYAGE_API_KEY=pa-...

# --- Google Cloud (STT + TTS) ---
#
# Two paths involved: where the service-account JSON lives on YOUR LAPTOP,
# and where it appears INSIDE the backend container. docker-compose bind-mounts
# the host file to the container path.
#
# GOOGLE_APPLICATION_CREDENTIALS_SOURCE: absolute path on your laptop to the
# service-account JSON downloaded from GCP. The role needs roles/speech.client
# and roles/texttospeech.user. If unset, the compose file mounts /dev/null and
# voice STT/TTS will fail at the Google API call — the rest of the app still
# runs.
GOOGLE_APPLICATION_CREDENTIALS_SOURCE=

# GOOGLE_APPLICATION_CREDENTIALS_MOUNT_POINT: where the JSON appears INSIDE
# the container. Google's official client libraries auto-read this path via
# the standard GOOGLE_APPLICATION_CREDENTIALS env var, which compose sets from
# this value. You normally don't need to change this.
GOOGLE_APPLICATION_CREDENTIALS_MOUNT_POINT=/run/secrets/google-credentials.json

# Postgres (defaults match ops/docker-compose.yml)
POSTGRES_URL=postgresql+asyncpg://mccauley:mccauley@db:5432/mccauley

# Session cookie signing key (any random string for local dev)
SESSION_SECRET=change-me-if-running-remotely
