# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI embeddings
VOYAGE_API_KEY=pa-...

# Google Cloud (STT + TTS). Path to service-account JSON inside the backend container.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-credentials.json

# Postgres (defaults match ops/docker-compose.yml)
POSTGRES_URL=postgresql+asyncpg://mccauley:mccauley@db:5432/mccauley

# Session cookie signing key (any random string for local dev)
SESSION_SECRET=change-me-for-local-dev
