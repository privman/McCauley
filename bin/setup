#!/usr/bin/env bash
# One-time setup for contributors. Installs backend + frontend dev
# dependencies and wires up the pre-push git hook. Idempotent — safe
# to re-run after a fresh clone or after pulling new dependencies.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo
echo "── backend dev deps (in backend/.venv) ─────────────"
if ! command -v python3 > /dev/null 2>&1; then
    echo "  ✗ python3 not found. Install Python 3.12+ and re-run."
    echo "    macOS: \`xcode-select --install\` or \`brew install python@3.12\`"
    echo "    Debian/Ubuntu: \`sudo apt install python3 python3-venv\`"
    exit 1
fi
if [ ! -d backend/.venv ]; then
    echo "  creating backend/.venv..."
    python3 -m venv backend/.venv
fi
backend/.venv/bin/python -m pip install --upgrade pip > /dev/null
(cd backend && ./.venv/bin/pip install -e ".[dev]")

echo
echo "── frontend dev deps ───────────────────────────────"
(cd frontend && npm install)

echo
echo "── pre-push hook ───────────────────────────────────"
git config core.hooksPath .githooks

echo
echo "Done."
